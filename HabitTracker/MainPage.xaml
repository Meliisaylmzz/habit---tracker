<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTracker.MainPage"
             Title="Alışkanlıklarım">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Entry x:Name="HabitEntry" Placeholder="Yeni alışkanlık yaz (örn. Su iç)" />
        <Button Text="Ekle" Clicked="OnAddClicked" />

        <CollectionView x:Name="HabitList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Spacing="10" Padding="0,4">
                        <CheckBox IsChecked="{Binding IsDone}" VerticalOptions="Center" />
                        <Label Text="{Binding Name}" FontSize="20" VerticalOptions="Center" />
                        <Button Text="Sil" Clicked="OnDeleteClicked" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>