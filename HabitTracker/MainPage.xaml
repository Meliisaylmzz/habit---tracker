<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTracker.MainPage"
             Title="Alışkanlıklarım"
             BackgroundColor="{AppThemeBinding Light=#F4F6FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20" RowSpacing="16">

        <Label Grid.Row="0"
               Text="Bugün neleri yapacaksın?"
               FontSize="26"
               FontAttributes="Bold" />

        <Border Grid.Row="1"
                StrokeThickness="0"
                Padding="20"
                BackgroundColor="#6C63FF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Label Text="Bugünün özeti"
                       FontSize="14"
                       TextColor="#E0DEFF" />
                <Label x:Name="SummaryLabel"
                       Text="0 / 0 tamamlandı"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White" />
                <ProgressBar x:Name="SummaryProgress"
                             Progress="0"
                             ProgressColor="White" />
                <Label x:Name="BestStreakLabel"
                       Text="🏆 En uzun seri: 0 gün"
                       FontSize="14"
                       TextColor="White" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    Padding="12,0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="HabitEntry" Placeholder="Yeni alışkanlık yaz" />
            </Border>

            <Button Grid.Column="1"
                    Text="Ekle"
                    Clicked="OnAddClicked"
                    BackgroundColor="#6C63FF"
                    TextColor="White"
                    CornerRadius="12" />
        </Grid>

        <CollectionView Grid.Row="3" x:Name="HabitList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <CheckBox Grid.Column="0"
                                      Color="#6C63FF"
                                      IsChecked="{Binding IsDone}"
                                      CheckedChanged="OnCheckChanged"
                                      VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding Name}" FontSize="18" />
                                <Label Text="{Binding StreakText}"
                                       FontSize="14"
                                       TextColor="#FF9F43" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="Sil"
                                    Clicked="OnDeleteClicked"
                                    BackgroundColor="#FF5C5C"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>